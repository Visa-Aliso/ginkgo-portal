{
  "name": "ginkgo-portal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run check:config && npm run check:content && vite --host 127.0.0.1",
    "check": "tsc --noEmit && npm run check:config && npm run check:content",
    "check:content": "node --experimental-strip-types scripts/check-content.mjs",
    "test": "node --experimental-strip-types --test",
    "test:motion": "node --experimental-strip-types --test tests/motion.test.mjs tests/page-transition.test.mjs",
    "build": "npm run check && vite build && node scripts/check-build.mjs",
    "verify": "npm test && npm run build",
    "preview": "vite preview --host 127.0.0.1",
    "check:config": "node --experimental-strip-types scripts/check-config.mjs"
  },
  "dependencies": {
    "lucide": "1.73.0"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
